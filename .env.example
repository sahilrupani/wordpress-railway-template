# ── Database ────────────────────────────────────────────────────
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
# Generate with: openssl rand -hex 32
WORDPRESS_DB_PASSWORD=change_me_to_a_long_random_string
MARIADB_ROOT_PASSWORD=change_me_to_a_different_long_random_string

# ── WordPress ───────────────────────────────────────────────────
# Table prefix. Changing it after install orphans your existing tables.
WORDPRESS_TABLE_PREFIX=wp_

# Host port to publish (container always listens on 80)
WORDPRESS_PORT=8080

# ── Security salts ──────────────────────────────────────────────
# On Railway these are generated for you. For local Docker, WordPress
# writes its own into wp-config.php on first run — you only need to set
# them here if you want them fixed across rebuilds. Fetch a fresh set:
#   https://api.wordpress.org/secret-key/1.1/salt/
# Changing a salt later logs every user out.
